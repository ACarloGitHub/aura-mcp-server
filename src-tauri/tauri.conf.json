{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AuraMCP",
  "version": "3.1.0",
  "identifier": "com.auramcp.server",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AuraMCP Control Panel",
        "width": 520,
        "height": 640,
        "minWidth": 440,
        "minHeight": 540,
        "visible": true,
        "decorations": true,
        "center": true,
        "resizable": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "deb", "rpm", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "AuraMCP Server launcher",
    "longDescription": "AuraMCP launches the Node.js based Model Context Protocol server for AnythingLLM and LM Studio. Bundles llama.cpp (CPU) and nomic-embed-text-v2-moe GGUF for local, Python-free RAG.",
    "publisher": "ACarloGitHub",
    "copyright": "Copyright (c) 2026 ACarloGitHub",
    "homepage": "https://github.com/ACarloGitHub/aura-mcp-server",
    "resources": [
      "../vendor/llama.cpp/windows/*",
      "../vendor/llama.cpp/macos/*",
      "../vendor/llama.cpp/linux/*"
    ],
    "externalBin": [],
    "createUpdaterArtifacts": false
  }
}
