{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AuraMCP",
  "version": "3.1.0",
  "identifier": "com.auramcp.server",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AuraMCP",
        "width": 1,
        "height": 1,
        "visible": false,
        "decorations": false,
        "center": false,
        "resizable": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "deb", "rpm", "appimage", "app"],
    "icon": [
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "AuraMCP Server launcher",
    "longDescription": "AuraMCP launches the Node.js based Model Context Protocol server for AnythingLLM and LM Studio. Bundles llama.cpp (CPU) and nomic-embed-text-v2-moe GGUF for local, Python-free RAG.",
    "publisher": "ACarloGitHub",
    "copyright": "Copyright (c) 2026 ACarloGitHub",
    "homepage": "https://github.com/ACarloGitHub/aura-mcp-server",
    "resources": [
      {
        "src": "../vendor/llama.cpp/windows/*",
        "target": ["msi", "nsis"]
      },
      {
        "src": "../vendor/llama.cpp/macos/*",
        "target": ["dmg", "app"]
      },
      {
        "src": "../vendor/llama.cpp/linux/*",
        "target": ["deb", "rpm", "appimage"]
      }
    ],
    "externalBin": [],
    "createUpdaterArtifacts": false
  }
}
