{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the AuraMCP Control Panel window: core Tauri APIs, dialog, opener. Custom IPC commands (#[tauri::command]) are auto-allowed.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "core:webview:default",
    "core:app:default",
    "dialog:default",
    "opener:default",
    "opener:allow-open-path"
  ]
}