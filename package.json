{
  "name": "aura-mcp-server",
  "version": "2.0.0",
  "description": "Cross-platform MCP server for AnythingLLM / LM Studio — tools for file system, shell, wiki, RAG, planner, web search and AnythingLLM integration",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "start:debug": "cross-env MCP_DEBUG=1 node dist/index.js",
    "check": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "lm-studio",
    "anythingllm",
    "tools",
    "shell",
    "exec",
    "cross-platform",
    "rag",
    "wiki",
    "planner"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/node-notifier": "^8.0.5",
    "typescript": "^5.9.3"
  }
}
